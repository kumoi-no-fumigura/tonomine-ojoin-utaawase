 "poems": [
  {
   "seq": "1",
   "text": "みちゆきの人もとひけり珍らしく梅さきそむる宿のかきねは",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "めつらしく梅の花けさ咲にけり宿のあるしも匂ひことなり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春まちしかひも有かないつしかと我花そのゝ梅さきにけり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "すきそめて宿をにほはす梅のはな誰かたちえを折にこさらむ",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "我宿にひらけそめぬる梅花にほはん春そ數もしられぬ",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あさとあくる風の匂ひにおとろけはよのまに梅の花咲にけり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "かは岸のわか枝の梅も咲にけり岡へにいまはゆきて折はや",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "梅花さき初ぬれは我宿に鶯のねもともしからめや",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "ちりはかり咲そむるよりわか宿の梅の匂にしる物そなき",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "梅のはな匂ふさかりの宿なれは梢をのみそなかめつゝをる",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "春風やまたうちとけてふかさらむうすく氷の池にのこれる",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "曇りなき春のかゝみとみゆるかなひとへ殘れる池の氷は",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "こち風にとけゆく池の氷うすみをしのはふきも春めきにけり",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "春風の吹そめしよりいつしかと池の氷のうすくもある哉",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "春かすみ冬を隔てたちぬれと池の氷そひとへのこれる",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "こち風にとけはてねかし薄こほり池の藤浪あやかみゆへく",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
